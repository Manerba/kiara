[Unit]
Description=KIara Knowledge System
After=network.target
Wants=network.target
OnFailure=kiara-failure-logger@%n.service

[Service]
Type=simple
User=kiara
Group=kiara
WorkingDirectory=/opt/kiara
ExecStart=/opt/kiara/venv/bin/kiara serve
Restart=on-failure
RestartSec=5s
Environment=KIARA_CONFIG=/etc/kiara/kiara.yaml

# Hardening
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# NoNewPrivileges deaktiviert: Worker/Admin-Pfade nutzen sudo (mount/install/systemctl-restart/davfs-tee)
NoNewPrivileges=false
ReadWritePaths=/var/lib/kiara /etc/kiara /var/log/kiara /opt/kiara/.cache /etc/davfs2
# Python JIT benoetigt Write+Execute
MemoryDenyWriteExecute=false

# Resource Limits
LimitNOFILE=65536
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
