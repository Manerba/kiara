{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiron.local/schemas/kiron-embedding-capabilities-v1.schema.json",
  "title": "KIron embedding capabilities V1",
  "description": "Normative discovery contract for one canonical KIron embedding model group. Unknown extension properties are permitted; known malformed fields fail validation.",
  "$comment": "Conformance requires this schema together with ADR-0009 behavioral invariants and RFC 8785/JCS I-JSON prerequisites. Valid Unicode scalar sequences in names and values are accepted without normalization; any lone surrogate U+D800 through U+DFFF is jcs_invalid_unicode_scalar and must fail before hashing.",
  "type": "object",
  "required": [
    "schema_version",
    "canonical_model_id",
    "aliases",
    "profiles"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "canonical_model_id": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/profile"
      }
    }
  },
  "$defs": {
    "sha256Id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableNonemptyString": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "canonicalParameter": {
      "description": "Recursive V1 hash parameter. Object names and string values accept valid Unicode scalar sequences without normalization; JCS sorts names by raw UTF-16 code units. Lone surrogates are rejected by the required behavioral JCS/I-JSON validator.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/canonicalParameter"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/canonicalParameter"
          }
        }
      ]
    },
    "parameterObject": {
      "description": "Unicode object names are permitted and participate in RFC 8785 UTF-16 code-unit ordering.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/canonicalParameter"
      }
    },
    "digestFile": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256Hex"
        }
      }
    },
    "backend": {
      "type": "object",
      "required": [
        "type",
        "implementation",
        "implementation_revision"
      ],
      "properties": {
        "type": {
          "enum": [
            "kiron_embeddings",
            "ollama"
          ]
        },
        "implementation": {
          "type": "string",
          "minLength": 1
        },
        "implementation_revision": {
          "$ref": "#/$defs/nullableNonemptyString"
        }
      }
    },
    "artifact": {
      "type": "object",
      "required": [
        "repository",
        "revision",
        "manifest_digest",
        "weights",
        "auxiliary"
      ],
      "properties": {
        "repository": {
          "$ref": "#/$defs/nullableNonemptyString"
        },
        "revision": {
          "$ref": "#/$defs/nullableNonemptyString"
        },
        "manifest_digest": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "weights": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/digestFile"
          }
        },
        "auxiliary": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/digestFile"
          }
        }
      }
    },
    "roleLimits": {
      "type": "object",
      "required": [
        "search_document",
        "search_query"
      ],
      "properties": {
        "search_document": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "search_query": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "maxInputTokens": {
      "type": "object",
      "required": [
        "unit",
        "counting",
        "truncation",
        "overflow",
        "by_role"
      ],
      "properties": {
        "unit": {
          "const": "tokenizer_tokens"
        },
        "counting": {
          "const": "after_server_formatting_including_special_tokens"
        },
        "truncation": {
          "enum": [
            "right",
            "unknown"
          ]
        },
        "overflow": {
          "enum": [
            "truncate",
            "late_chunk_fallback",
            "unknown"
          ]
        },
        "by_role": {
          "$ref": "#/$defs/roleLimits"
        }
      }
    },
    "inputTypeAlias": {
      "type": "object",
      "required": [
        "alias",
        "canonical"
      ],
      "properties": {
        "alias": {
          "type": "string",
          "minLength": 1
        },
        "canonical": {
          "enum": [
            "search_document",
            "search_query"
          ]
        }
      }
    },
    "inputType": {
      "type": "object",
      "required": [
        "supported",
        "additional_task_roles",
        "aliases",
        "role_sensitive",
        "required",
        "default",
        "missing_role_behavior"
      ],
      "properties": {
        "supported": {
          "type": "array",
          "prefixItems": [
            {
              "const": "search_document"
            },
            {
              "const": "search_query"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "additional_task_roles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "not": {
              "enum": [
                "search_document",
                "search_query"
              ]
            }
          },
          "uniqueItems": true
        },
        "aliases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inputTypeAlias"
          }
        },
        "role_sensitive": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "default": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "search_document",
            "search_query",
            null
          ]
        },
        "missing_role_behavior": {
          "enum": [
            "use_default",
            "reject",
            "no_op",
            "unknown"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role_sensitive": {
                "const": true
              }
            },
            "required": [
              "role_sensitive"
            ]
          },
          "then": {
            "oneOf": [
              {
                "properties": {
                  "required": {
                    "const": false
                  },
                  "default": {
                    "const": "search_document"
                  },
                  "missing_role_behavior": {
                    "const": "use_default"
                  }
                }
              },
              {
                "properties": {
                  "required": {
                    "const": true
                  },
                  "default": {
                    "const": null
                  },
                  "missing_role_behavior": {
                    "const": "reject"
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "role_sensitive": {
                "const": false
              }
            },
            "required": [
              "role_sensitive"
            ]
          },
          "then": {
            "properties": {
              "required": {
                "const": false
              },
              "default": {
                "const": null
              },
              "missing_role_behavior": {
                "const": "no_op"
              }
            }
          }
        }
      ]
    },
    "formatting": {
      "type": "object",
      "required": [
        "template",
        "parameters"
      ],
      "properties": {
        "template": {
          "type": [
            "string",
            "null"
          ]
        },
        "parameters": {
          "$ref": "#/$defs/parameterObject"
        }
      }
    },
    "pipeline": {
      "type": "object",
      "required": [
        "tokenizer",
        "formatting",
        "pooling",
        "normalization",
        "parameters"
      ],
      "properties": {
        "tokenizer": {
          "type": "object",
          "required": [
            "repository",
            "revision"
          ],
          "properties": {
            "repository": {
              "$ref": "#/$defs/nullableNonemptyString"
            },
            "revision": {
              "$ref": "#/$defs/nullableNonemptyString"
            }
          }
        },
        "formatting": {
          "type": "object",
          "required": [
            "search_document",
            "search_query"
          ],
          "properties": {
            "search_document": {
              "$ref": "#/$defs/formatting"
            },
            "search_query": {
              "$ref": "#/$defs/formatting"
            }
          },
          "additionalProperties": false
        },
        "pooling": {
          "type": "object",
          "required": [
            "method",
            "parameters"
          ],
          "properties": {
            "method": {
              "enum": [
                "mean",
                "cls",
                "last_token",
                "late_chunk_mean",
                "token_projection",
                "unknown"
              ]
            },
            "parameters": {
              "$ref": "#/$defs/parameterObject"
            }
          }
        },
        "normalization": {
          "type": "object",
          "required": [
            "method",
            "dtype",
            "scope"
          ],
          "properties": {
            "method": {
              "enum": [
                "l2",
                "none",
                "unknown"
              ]
            },
            "dtype": {
              "enum": [
                "float32",
                "float16",
                "bfloat16",
                "unknown"
              ]
            },
            "scope": {
              "enum": [
                "vector",
                "token",
                "unknown"
              ]
            }
          }
        },
        "parameters": {
          "$ref": "#/$defs/parameterObject"
        }
      }
    },
    "verification": {
      "type": "object",
      "required": [
        "status",
        "evidence",
        "blocking_reasons"
      ],
      "properties": {
        "status": {
          "enum": [
            "verified",
            "unverified"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "blocking_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "profile": {
      "type": "object",
      "required": [
        "profile_id",
        "kind",
        "endpoint",
        "default_for_endpoint",
        "backend",
        "artifact",
        "dimensions",
        "max_input_tokens",
        "output_normalized",
        "similarity",
        "input_type",
        "formatting_owner",
        "pipeline",
        "verification",
        "index_compatibility_id",
        "query_compatibility_id"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "kind": {
          "enum": [
            "dense",
            "late_chunking",
            "multi_vector"
          ]
        },
        "endpoint": {
          "enum": [
            "/api/embed",
            "/api/embed_late",
            "/api/embed_colbert"
          ]
        },
        "default_for_endpoint": {
          "type": "boolean"
        },
        "backend": {
          "$ref": "#/$defs/backend"
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "dimensions": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_input_tokens": {
          "$ref": "#/$defs/maxInputTokens"
        },
        "output_normalized": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "similarity": {
          "enum": [
            "cosine",
            "dot_product",
            "maxsim_cosine",
            "unknown"
          ]
        },
        "input_type": {
          "$ref": "#/$defs/inputType"
        },
        "formatting_owner": {
          "const": "server"
        },
        "pipeline": {
          "$ref": "#/$defs/pipeline"
        },
        "verification": {
          "$ref": "#/$defs/verification"
        },
        "index_compatibility_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "query_compatibility_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256Id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "dense"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "endpoint": {
                "const": "/api/embed"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "late_chunking"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "endpoint": {
                "const": "/api/embed_late"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "multi_vector"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "endpoint": {
                "const": "/api/embed_colbert"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verification": {
                "properties": {
                  "status": {
                    "const": "verified"
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "verification"
            ]
          },
          "then": {
            "properties": {
              "backend": {
                "properties": {
                  "implementation_revision": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "artifact": {
                "properties": {
                  "weights": {
                    "minItems": 1
                  }
                },
                "anyOf": [
                  {
                    "properties": {
                      "repository": {
                        "type": "string",
                        "minLength": 1
                      },
                      "revision": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  {
                    "properties": {
                      "manifest_digest": {
                        "$ref": "#/$defs/sha256Id"
                      }
                    }
                  }
                ]
              },
              "dimensions": {
                "type": "integer",
                "minimum": 1
              },
              "max_input_tokens": {
                "properties": {
                  "truncation": {
                    "const": "right"
                  },
                  "overflow": {
                    "enum": [
                      "truncate",
                      "late_chunk_fallback"
                    ]
                  },
                  "by_role": {
                    "properties": {
                      "search_document": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "search_query": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  }
                }
              },
              "output_normalized": {
                "type": "boolean"
              },
              "similarity": {
                "not": {
                  "const": "unknown"
                }
              },
              "input_type": {
                "properties": {
                  "role_sensitive": {
                    "type": "boolean"
                  },
                  "missing_role_behavior": {
                    "not": {
                      "const": "unknown"
                    }
                  }
                }
              },
              "pipeline": {
                "properties": {
                  "tokenizer": {
                    "properties": {
                      "repository": {
                        "type": "string",
                        "minLength": 1
                      },
                      "revision": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "formatting": {
                    "properties": {
                      "search_document": {
                        "properties": {
                          "template": {
                            "type": "string"
                          }
                        }
                      },
                      "search_query": {
                        "properties": {
                          "template": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  },
                  "pooling": {
                    "properties": {
                      "method": {
                        "not": {
                          "const": "unknown"
                        }
                      }
                    }
                  },
                  "normalization": {
                    "properties": {
                      "method": {
                        "not": {
                          "const": "unknown"
                        }
                      },
                      "dtype": {
                        "not": {
                          "const": "unknown"
                        }
                      },
                      "scope": {
                        "not": {
                          "const": "unknown"
                        }
                      }
                    }
                  }
                }
              },
              "verification": {
                "properties": {
                  "evidence": {
                    "minItems": 1
                  },
                  "blocking_reasons": {
                    "maxItems": 0
                  }
                }
              },
              "index_compatibility_id": {
                "$ref": "#/$defs/sha256Id"
              },
              "query_compatibility_id": {
                "$ref": "#/$defs/sha256Id"
              }
            }
          },
          "else": {
            "properties": {
              "verification": {
                "properties": {
                  "blocking_reasons": {
                    "minItems": 1
                  }
                }
              },
              "index_compatibility_id": {
                "const": null
              },
              "query_compatibility_id": {
                "const": null
              }
            }
          }
        }
      ]
    }
  }
}
